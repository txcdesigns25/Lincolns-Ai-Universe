# ── Required ─────────────────────────────────────────────
DATABASE_URL=postgres://universe:universe@localhost:5432/universe
OWNER_PASSWORD=choose-a-long-password            # dashboard login (min 8 chars)
SESSION_SECRET=paste-a-random-string-of-32-plus-characters

# ── Claude (optional: without it, agents use the free mock) ──
ANTHROPIC_API_KEY=
# Cheap by default. Routine work (all scheduled cycles, chats):
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=low                                # low | medium | high
CLAUDE_MAX_TOKENS=3000
# Important work only (boosted agents, inbound customer leads, owner-flagged tasks):
CLAUDE_MODEL_IMPORTANT=claude-sonnet-5-5
CLAUDE_EFFORT_IMPORTANT=medium
CLAUDE_MAX_TOKENS_IMPORTANT=6000

# ── Telegram remote control (optional) ───────────────────
TELEGRAM_BOT_TOKEN=                              # from @BotFather
TELEGRAM_OWNER_ID=                               # your numeric user id (from @userinfobot)

# ── Payments / commerce (optional, add when ready) ───────
STRIPE_WEBHOOK_SECRET=
SHOPIFY_STORE_DOMAIN=                            # a SEPARATE store, never TXC Designs
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_PRODUCT_STATUS=DRAFT                     # DRAFT (default) or ACTIVE
SHOPIFY_BLOCKED_STORES=                          # extra stores to always refuse (comma-separated)

# ── Worker tuning ────────────────────────────────────────
WORKER_CONCURRENCY=2
AGENT_MAX_TURNS=8
NOTIFY_WEBHOOK_URL=                              # optional Slack/Discord webhook
